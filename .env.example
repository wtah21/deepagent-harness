# DeepAgent Harness 环境配置示例
# 复制为 .env 并填入真实值：cp .env.example .env

# ── 模型服务（DeepSeek，OpenAI 兼容接口）──────────────────────
# API 密钥（必填）：https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=
# 接口地址与模型名
BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
TEMPERATURE=0.7
MAX_TOKENS=1024

# ── LangSmith 追踪（可选）────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=harness_engineering

# ── 上下文管理（混合分层压缩）────────────────────────────────
# 0 表示调用接口自动探测模型上下文窗口；显式配置时优先使用该值
CONTEXT_WINDOW_TOKENS=0
# 占用超过窗口的该比例时触发压缩
CONTEXT_TRIGGER_RATIO=0.7
# 最近 N 轮完整保留
CONTEXT_RECENT_ROUNDS=5
# 最近 N 轮之内（即 N_SUMMARY 轮前）做摘要压缩，更早的直接丢弃
CONTEXT_SUMMARY_ROUNDS=15

# ── 工具输出治理 ─────────────────────────────────────────────
# 单个工具结果进入上下文前的 token 预算，超过则压缩
TOOL_OUTPUT_TOKEN_BUDGET=3000
# 交给 JEV 判断策略时，工具结果保留的字符数
TOOL_OUTPUT_JEV_SAMPLE_CHARS=1000
# 结构化截断时完整保留的前几条记录
TOOL_OUTPUT_HEAD_RECORDS=5
# JEV 置信度低于该值时改用本地启发式判断
TOOL_OUTPUT_JEV_MIN_CONFIDENCE=0.2
# 单次 JEV 调用的超时（秒）
TOOL_OUTPUT_JEV_TIMEOUT=6
# 过滤代码在沙箱中的执行超时（秒）
TOOL_OUTPUT_FILTER_TIMEOUT=30

# ── JEV 决策模型（TypeSafe System One，可选）─────────────────
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest

# ── A2A 远端 Agent ───────────────────────────────────────────
# 拉取 Agent Card 的超时（秒）
A2A_CARD_TIMEOUT=20
# 调用远端 Agent 的阻塞等待超时（秒）
A2A_TIMEOUT=120

# ── Docker 隔离执行 ──────────────────────────────────────────
# 每个项目一个常驻容器（1 CPU / 1GB 内存），缺镜像时自动拉取
DOCKER_IMAGE=python:3.11-slim

# ── 子智能体递归上限 ─────────────────────────────────────────
# ReAct 每轮消耗约 2-3 个超步，600 步约支持 300 次工具调用
SUBAGENT_RECURSION_LIMIT=600
